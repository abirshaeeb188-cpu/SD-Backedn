PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8080

# Postgres connection string (Neon, Render, Railway, Supabase, RDS, or local)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Only used if DATABASE_URL is not set
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me
PGDATABASE=desert_sands

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

OTP_TTL_MINUTES=5
OTP_DEBUG_ECHO=true

# Gmail SMTP (Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Sand and Gravel Concrete Supply <no-reply@example.com>"

# Inbox that contact-form messages get sent to
CONTACT_INBOX_EMAIL=meeralbloshi46@gmail.com
